APP_NAME="ADN Fidelidad"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fidelidad.adnpublicidad.site
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
FIDELIDAD_DOMAIN=fidelidad.adnpublicidad.site
BRAND_LOGO_PATH=brand/adn-publicidad-logo.png

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@adnpublicidad.site"
MAIL_FROM_NAME="ADN Fidelidad"

# Software Master (contrato v1; ver docs/API_SOFTWARE_MASTER.md)
MASTER_WEBHOOK_SECRET=
MASTER_LINK_SECRET=
MASTER_API_URL=https://master.adnpublicidad.site
MASTER_API_KEY=
MASTER_API_SECRET=
MASTER_GRACE_HOURS=72

# Google Wallet (rutas fuera de public/)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=/home/USUARIO/secretos/google-wallet.json
GOOGLE_WALLET_ORIGINS=https://fidelidad.adnpublicidad.site

# Apple Wallet (rutas fuera de public/)
APPLE_WALLET_ENABLED=false
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PATH=/home/USUARIO/secretos/pass.p12
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=/home/USUARIO/secretos/wwdr.pem
APPLE_ORGANIZATION="ADN Publicidad"
